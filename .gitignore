# ============================================
# SafeHer - Root .gitignore
# ============================================

# Dependencies
node_modules/
*/node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables (SECRETS!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env

# Uploads
uploads/
backend/uploads/
frontend/uploads/

# Build outputs
build/
dist/
frontend/build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Testing
coverage/

# Misc
.cache/